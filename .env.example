# Industrial Energy Efficiency Copilot - Global Environment Configuration

# --- Frontend Settings ---
# URL of the Backend Gateway (REST)
VITE_API_URL=http://localhost:8000

# URL of the Backend Gateway (WebSocket for real-time telemetry)
VITE_WS_URL=ws://localhost:8000/ws/copilot

# --- Backend Settings ---
# Port for FastAPI Gateway & WebSocket server
PORT=8000

# Address of internal gRPC Microservices
ANALYTICS_HOST=localhost:50051
CNG_HOST=localhost:50052
